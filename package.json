{
  "name": "moneyapp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.10 <23",
    "npm": ">=10"
  },
  "packageManager": "npm@10.9.0",
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "predev": "npm run doctor",
    "prebuild": "npm run doctor",
    "pretest": "npm run doctor",
    "prelint": "npm run doctor",
    "dev": "next dev --webpack",
    "dev:mobile": "next dev --webpack --hostname 0.0.0.0 --port 3000",
    "tunnel": "lt --port 3000",
    "mobile": "concurrently \"npm run dev:mobile\" \"npm run tunnel\"",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:copy": "npx cap copy",
    "cap:sync": "CAPACITOR_USE_REMOTE_SERVER=1 npx cap sync",
    "cap:sync:fresh": "CAPACITOR_USE_REMOTE_SERVER=1 CAPACITOR_CACHE_BUSTER=$(date +%s) npx cap sync",
    "cap:sync:android:fresh": "CAPACITOR_USE_REMOTE_SERVER=1 CAPACITOR_CACHE_BUSTER=$(date +%s) npx cap sync android",
    "cap:sync:ios:fresh": "CAPACITOR_USE_REMOTE_SERVER=1 CAPACITOR_CACHE_BUSTER=$(date +%s) npx cap sync ios",
    "cap:clean:ios-build": "rm -rf ios/App/build",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "mobile:android": "npm run cap:sync && npm run cap:open:android",
    "mobile:ios": "npm run cap:sync && npm run cap:open:ios",
    "mobile:android:fresh": "npm run cap:sync:android:fresh && npm run cap:open:android",
    "mobile:ios:fresh": "npm run cap:sync:ios:fresh && npm run cap:open:ios",
    "test:load": "node scripts/load-smoke.mjs",
    "test:smoke:deploy": "node scripts/smoke-deploy.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "deploy": "vercel --prod",
    "deploy:preview": "vercel"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.1",
    "@capacitor/core": "^7.6.1",
    "@capacitor/ios": "^7.6.1",
    "@capacitor/status-bar": "^7.0.6",
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.101.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.7.0",
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "stripe": "^22.0.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "jsdom": "^26.1.0",
    "localtunnel": "^2.0.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vercel": "^53.1.0",
    "vitest": "^3.2.4"
  }
}
